{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          { "type": "command", "command": "/Library/Frameworks/Python.framework/Versions/3.14/bin/python3 /Users/benk/Downloads/Obsidian/Gen/.scripts/vault_ctx.py start", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(git commit *)", "command": "/Library/Frameworks/Python.framework/Versions/3.14/bin/python3 /Users/benk/Downloads/Obsidian/Gen/.scripts/vault_ctx.py commit", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "/Library/Frameworks/Python.framework/Versions/3.14/bin/python3 /Users/benk/Downloads/Obsidian/Gen/.scripts/vault_ctx.py stop", "timeout": 10 }
        ]
      }
    ]
  }
}
