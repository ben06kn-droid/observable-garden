__pycache__/
*.pyc
.pytest_cache/
# No trailing slash: a pattern ending in "/" matches a directory only, so a
# symlinked .venv -- which is what `git worktree add` needs, since the venv is
# not in the tree -- slipped past `.venv/` and was committed by a `git add -A`.
# Without the slash the pattern matches a directory, a file, or a symlink.
.venv
venv
*.egg-info/
.cache/
.DS_Store
# the runners' log folders (cloud/run.sh writes logs/ where it runs), not examples/logs/
/logs/
research/logs/
runs/_logs/
runs/_logs_batch2/
# 7.4 raw vendor bars: never in git. The manifest (data/adr_manifest.json) is
# tracked and carries a hash per file instead.
data/raw

# Sealed holdout copies never enter the repository, wherever a path points from.
# The 6.5 holdout's second copy is an openssl-encrypted archive on the Desktop;
# belt and braces, since that is outside the repository anyway.
*.enc
*.gpg
*.asc
Desktop/
data/class_tables/
data/planted_cache/
data/pinned/

# French long history: the host cut CSVs hold values; only their records (.cut.json) are tracked.
runs/french_long_cuts/*.csv

# ETF recent panel: the host cut CSVs hold values; only the cut record (.cut.json) is tracked.
runs/etf_recent_cuts/insample/

# ETF recent precompute: the class scored streams (~1.7 GB) stay out of git; the manifest and small files are tracked.
runs/etf_recent/*/precompute/class_scored.npy

# Since the 2026-10 cleanup the research record is under research/ and runs from there. The
# root patterns above stay: files already on disk at the old paths (machine-local data in data/,
# cut CSVs and the precompute's class streams under runs/) are where they were and stay ignored.
# These cover the same outputs written in the new layout.
research/runs/_logs/
research/runs/_logs_batch2/
research/runs/french_long_cuts/*.csv
research/runs/etf_recent_cuts/insample/
research/runs/etf_recent/*/precompute/class_scored.npy
research/data/raw
research/data/class_tables/
research/data/planted_cache/
research/data/pinned/
